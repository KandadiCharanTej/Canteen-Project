# ─────────── SECURITY ───────────
# Generate a secure secret key using: openssl rand -hex 32
SECRET_KEY=PRODUCTION_SECRET_KEY_CHANGE_ME

# ─────────── DATABASE (PostgreSQL) ───────────
# Use Neon.tech, Supabase, or Railway PostgreSQL
SQLALCHEMY_DATABASE_URI=postgresql://user:password@hostname:port/dbname

# ─────────── CACHE (Redis) ───────────
# Use Upstash or Railway Redis
REDIS_URL=rediss://default:password@hostname:port

# ─────────── STORAGE (Cloudinary) ───────────
# For payment screenshots and menu images (Optional but recommended for production)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ─────────── CORS ───────────
# Comma-separated list of allowed origins (e.g., https://canteenfood.in,https://admin.canteenfood.in)
CORS_ORIGINS=*

# ─────────── SMS (Fast2SMS) ───────────
# Get your API Key from https://www.fast2sms.com/
SMS_API_KEY=YOUR_FAST2SMS_API_KEY_HERE
